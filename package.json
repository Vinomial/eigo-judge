{
  "name": "eigo-judge",
  "private": true,
  "description": "英語ジャッジ.アプリ自体はビルド不要(index.html を開くだけ).ここにあるのはテスト用の道具だけ.",
  "scripts": {
    "test": "eslint . && node tools/check.js && node tools/test-merge.js && node tools/test-ui.js",
    "lint": "eslint .",
    "test:ui": "node tools/test-ui.js",
    "test:rules": "firebase emulators:exec --only firestore --project demo-eigo \"node tools/test-rules.js\"",
    "test:sync": "firebase emulators:exec --only firestore,auth --project eigo-judge \"node tools/test-sync.js\"",
    "release": "node tools/release.js",
    "new": "node tools/new.js",
    "browser": "playwright-core install chromium"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "eslint": "^9.17.0",
    "firebase": "^10.12.2",
    "firebase-tools": "^13.29.1",
    "globals": "^14.0.0",
    "playwright-core": "1.48.2"
  }
}
